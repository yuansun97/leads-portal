DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/leads
CORS_ORIGINS=http://localhost:3000
ENVIRONMENT=development
# Set true only for local API testing without Supabase Auth. Forbidden in production.
DEV_AUTH_BYPASS=false

# Supabase (required for resume storage + JWT verification in production)
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Only needed for legacy HS256 projects. Projects on asymmetric signing keys
# (ES256/RS256) are verified via the JWKS endpoint derived from SUPABASE_URL.
SUPABASE_JWT_SECRET=
SUPABASE_RESUMES_BUCKET=resumes
LOCAL_UPLOAD_DIR=uploads

# Public lead abuse controls (per API replica)
LEAD_CREATE_PER_IP_PER_MINUTE=5
LEAD_CREATE_PER_EMAIL_PER_HOUR=10

# Resend — leave EMAIL_ENABLED=false to log emails locally
EMAIL_ENABLED=false
RESEND_API_KEY=
RESEND_FROM=Leads Portal <onboarding@resend.dev>
ATTORNEY_NOTIFY_EMAIL=attorney@example.com

OUTBOX_POLL_INTERVAL_SECONDS=2
OUTBOX_MAX_ATTEMPTS=8
